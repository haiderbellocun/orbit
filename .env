# ------------------------------------------------------------
# Auth (Google + JWT)
# ------------------------------------------------------------
# Generate a strong secret for JWT signing
JWT_SECRET=change-me
# Examples: 1h, 8h, 7d
JWT_EXPIRES_IN=7d

# Login por correo (POST /api/auth/local-email) sin Google — solo para desarrollo local.
# Sin esto, si NODE_ENV no es "development", el endpoint responde 404 "Not found".
ALLOW_LOCAL_EMAIL_AUTH=1

