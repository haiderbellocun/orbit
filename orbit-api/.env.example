DB_HOST=localhost
# En Cloud Run con conector Cloud SQL suele ser:
# DB_HOST=/cloudsql/PROYECTO:REGION:INSTANCIA
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=orbit
# Misma convención que en Cloud SQL (ej. base `core` + esquema `core`):
# DB_NAME=core
# DB_SCHEMA=core

PORT=4000

# Tiempo máx. para abrir conexión TCP a Postgres (ms). Evita que /api/auth/google cuelgue sin respuesta.
# DB_CONNECTION_TIMEOUT_MS=15000
# DB_POOL_MAX=10

# OAuth web client (mismo valor que en el frontend VITE_GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_ID=

# JWT firmado para la sesión Orbit
# JWT_SECRET=

# URL pública del frontend (tras login con Google redirect, el API redirige aquí)
# Producción ejemplo: https://orbit-frontend-xxxxx.run.app
# ORBIT_FRONTEND_URL=http://localhost:3000

# Rol LITE en catálogo core.role para login ORBIT (personas LITE en listados siguen usando este id en SQL)
# Si el id 9 es perfil operaciones en ORBIT, asigna aquí el id real del rol LITE (p. ej. 12)
# ORBIT_LITE_ROLE_ID=12

# Acceso temporal (reborn): solo estos correos reciben TODAS las capabilities (admin).
# Por defecto: camilo_quintero@cun.edu.co
# ORBIT_ACCESS_ALLOWLIST=camilo_quintero@cun.edu.co
#
# Acceso acotado a Planta Activa (ver/editar por área) está en código:
# orbit-api/src/lib/plantaActivaAccess.ts
# (sara_murillofo, leidy_bernal, tania_rocha)

# role_id con acceso total a ORBIT (desarrolladores + ops) — en pausa mientras rige la allowlist
# ORBIT_FULL_ACCESS_ROLE_IDS=1,10,13,19,42,43,44,45,46

# Opcional: habilita POST /api/auth/local-email además de NODE_ENV=development
# ALLOW_LOCAL_EMAIL_AUTH=1

# Notificaciones de nueva vacante (correo + campana in-app)
# Google / Gmail: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=desarrollofabrica@cun.edu.co
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=desarrollofabrica@cun.edu.co
# VACANCY_NOTIFY_EMAILS=camilo_quintero@cun.edu.co,laura_garcias@cun.edu.co,angie_ruizm@cun.edu.co
# Probar: npm run test:smtp