NODE_ENV=production
PORT=8080
API_PREFIX=/api

# La sesión JWT expira siempre a las 2 horas (política fijada en código).

DB_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DB_PORT=5432
DB_USER=orbit_user
DB_PASSWORD=__SECRET_MANAGER__
DB_NAME=orbit
DB_SCHEMA=public
DB_SSL=false

CORS_ORIGIN=https://ORBIT_FRONTEND_URL
# `none` permite frontend/API en sitios distintos y exige HTTPS; use `lax` si comparten sitio.
SESSION_COOKIE_SAME_SITE=none
