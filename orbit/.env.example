# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Orbit API base URL (optional). En producción debe ser el servicio BACKEND de Cloud Run + /api, no orbit-frontend.
VITE_API_URL="http://localhost:4000/api"

# Opcional: base URL solo para import Excel; si no se define, se usa VITE_API_URL.
# VITE_IMPORT_API_URL="http://localhost:4000/api"

# Solo si el API vive detrás del mismo host que el SPA (reverse proxy a Express): true
# VITE_ALLOW_SAME_ORIGIN_API=true

# Google OAuth Client ID (required for login)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# Opcional: muestra login por correo fuera de `npm run dev` (requiere API con ALLOW_LOCAL_EMAIL_AUTH o NODE_ENV=development)
# VITE_ALLOW_LOCAL_EMAIL_LOGIN=true
